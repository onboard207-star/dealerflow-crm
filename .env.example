# Runtime environment: development, test, staging, or production
APP_ENV=development

# PostgreSQL connection. Required for migrations, authentication, and operational data.
DATABASE_URL=

# Authentication secret: generate at least 32 high-entropy characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Separate high-entropy bearer secret for scheduler-only internal job routes.
DEALERFLOW_JOB_SECRET=

# Transactional account email. Use a verified sender domain outside local development.
DEALERFLOW_EMAIL_PROVIDER=resend
RESEND_API_KEY=
DEALERFLOW_EMAIL_FROM=DealerFlow <accounts@example.com>
DEALERFLOW_EMAIL_REPLY_TO=support@example.com

# Optional signed aggregate operational alerts. Never send customer payloads here.
DEALERFLOW_ALERT_WEBHOOK_URL=
DEALERFLOW_ALERT_WEBHOOK_SECRET=

# Evidence-only AI recommendations. Use a restricted project service-account key.
DEALERFLOW_AI_PROVIDER=openai
OPENAI_API_KEY=
DEALERFLOW_AI_MODEL=gpt-5.6

# Example only: credentialReference=TWILIO_DEMO resolves this secret.
DEALERFLOW_INTEGRATION_SECRET_TWILIO_DEMO=
# Exact public status callback URL returned by Twilio provisioning.
DEALERFLOW_INTEGRATION_SECRET_TWILIO_DEMO_WEBHOOK_URL=
