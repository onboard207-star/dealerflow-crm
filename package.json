{
  "name": "dealerflow-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=4",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "tenant:provision": "node scripts/provision-tenant.mjs",
    "tenant:seed-template": "node scripts/seed-dealership-template.mjs",
    "synthetic:seed": "node scripts/seed-synthetic-pilot.mjs --confirm SYNTHETIC-DEMO",
    "pilot:cutover:check": "node scripts/validate-pilot-cutover.mjs",
    "productization:check": "node scripts/validate-productization.mjs",
    "commercial:check": "node scripts/validate-commercial-launch.mjs",
    "scale:check": "node scripts/validate-scale-capacity.mjs",
    "enterprise:check": "node scripts/validate-enterprise-readiness.mjs",
    "verticals:check": "node scripts/validate-vertical-expansion.mjs",
    "developer-platform:check": "node scripts/validate-developer-platform.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "validate": "pnpm db:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "next": "15.5.21",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.6.0",
    "twilio": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.21",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.9.0"
}
