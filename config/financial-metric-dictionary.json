{
  "schemaVersion": 1,
  "allowedValueClasses": ["actual", "booked", "billed", "collected", "accrued-estimate", "forecast", "scenario"],
  "metrics": [
    { "key": "mrr", "name": "Monthly Recurring Revenue", "availability": "unavailable", "formula": "Sum eligible recurring monthly contract schedules", "valueClasses": ["actual", "booked"], "requiredSources": ["contracts", "subscriptions"], "exclusions": ["implementation fees", "pipeline", "unpaid pilots", "one-time usage spikes"], "ownerRole": "Finance" },
    { "key": "arr", "name": "Annual Recurring Revenue", "availability": "unavailable", "formula": "Eligible MRR multiplied by 12", "valueClasses": ["actual", "booked"], "requiredSources": ["contracts", "subscriptions"], "exclusions": ["implementation fees", "pipeline", "unpaid pilots", "non-recurring revenue"], "ownerRole": "Finance" },
    { "key": "mrr-bridge", "name": "MRR Bridge", "availability": "unavailable", "formula": "Beginning MRR + new + expansion + reactivation - contraction - churn = ending MRR", "valueClasses": ["actual", "booked"], "requiredSources": ["contracts", "subscriptions"], "exclusions": ["new-logo pipeline", "one-time revenue"], "ownerRole": "Finance" },
    { "key": "recurring-gross-margin", "name": "Recurring Gross Margin", "availability": "unavailable", "formula": "Eligible recurring revenue less defined recurring COGS", "valueClasses": ["actual", "accrued-estimate"], "requiredSources": ["subscriptions", "providerCostLedger", "usageCostLedger"], "exclusions": ["implementation revenue", "unallocated operating expense"], "ownerRole": "Finance" },
    { "key": "implementation-margin", "name": "Implementation Margin", "availability": "unavailable", "formula": "Implementation revenue less approved implementation delivery cost", "valueClasses": ["actual", "accrued-estimate"], "requiredSources": ["contracts", "implementationEffort"], "exclusions": ["recurring subscription revenue"], "ownerRole": "Finance" },
    { "key": "nrr", "name": "Net Revenue Retention", "availability": "unavailable", "formula": "Beginning cohort recurring revenue plus expansion less contraction and churn, divided by beginning cohort recurring revenue", "valueClasses": ["actual"], "requiredSources": ["contracts", "subscriptions"], "exclusions": ["new-logo revenue", "one-time revenue"], "ownerRole": "Finance" },
    { "key": "grr", "name": "Gross Revenue Retention", "availability": "unavailable", "formula": "Beginning cohort recurring revenue less contraction and churn, divided by beginning cohort recurring revenue", "valueClasses": ["actual"], "requiredSources": ["contracts", "subscriptions"], "exclusions": ["expansion", "new-logo revenue", "one-time revenue"], "ownerRole": "Finance" },
    { "key": "cac", "name": "Customer Acquisition Cost", "availability": "unavailable", "formula": "Approved acquisition costs divided by eligible new customers for the defined period", "valueClasses": ["actual", "accrued-estimate"], "requiredSources": ["accountingSystem", "contracts"], "exclusions": ["incomplete acquisition costs", "unqualified pipeline"], "ownerRole": "Finance" },
    { "key": "ltv", "name": "Customer Lifetime Value", "availability": "unavailable", "formula": "Scenario-based contribution using approved retention and gross-margin assumptions", "valueClasses": ["scenario"], "requiredSources": ["subscriptions", "providerCostLedger", "approvedFinanceOwner"], "exclusions": ["unsupported retention history", "unlabeled assumptions"], "ownerRole": "Finance" },
    { "key": "cash-balance", "name": "Cash Balance", "availability": "unavailable", "formula": "Authoritative connected bank/accounting balance", "valueClasses": ["actual"], "requiredSources": ["bankFeed"], "exclusions": ["scenario cash", "bookings", "uncollected invoices"], "ownerRole": "Finance" },
    { "key": "net-burn", "name": "Net Burn", "availability": "unavailable", "formula": "Defined cash operating outflows less cash operating inflows for the period", "valueClasses": ["actual", "forecast", "scenario"], "requiredSources": ["bankFeed", "accountingSystem", "payrollSystem"], "exclusions": ["unlabeled non-cash entries"], "ownerRole": "Finance" },
    { "key": "runway", "name": "Runway", "availability": "unavailable", "formula": "Cash balance divided by forecast net burn under stated assumptions", "valueClasses": ["forecast", "scenario"], "requiredSources": ["bankFeed", "accountingSystem", "payrollSystem", "forecastVersions"], "exclusions": ["guaranteed dates", "unlabeled assumptions"], "ownerRole": "Finance" },
    { "key": "provider-cost-per-tenant", "name": "Provider Cost per Tenant", "availability": "unavailable", "formula": "Tenant-attributable provider units multiplied by the effective approved provider price version", "valueClasses": ["actual", "accrued-estimate"], "requiredSources": ["providerCostLedger", "usageCostLedger"], "exclusions": ["synthetic/demo usage", "unversioned provider estimates"], "ownerRole": "Finance" }
  ]
}
